---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { AMAZON_CA_LINKING_ENABLED, AMAZON_ASSOCIATE_STATEMENT, AMAZON_CA_ACCOUNT_DECLARATION } from '../config/site';
---

<BaseLayout title="Affiliate disclosure" description="How ApocalypseGearLab earns commissions from affiliate links and how that affects our editorial decisions.">
  <div class="container section stack">
    <Breadcrumbs items={[{ label: 'Affiliate disclosure' }]} />
    <h1>Affiliate disclosure</h1>
    <p>This site is supported by affiliate links. When you buy through a link marked as an affiliate link, we may earn a commission at no extra cost to you.</p>
    <h2>Editorial independence</h2>
    <p>Commissions do not decide which products we cover or how we rate them. Product pages state whether a product was researched from public information or physically tested, and when its details were last verified.</p>
    <section aria-labelledby="amazon-participation" data-account-declaration>
      <h2 id="amazon-participation">Amazon.ca participation</h2>
      <p>The site owner reports that the Amazon Associates Canada account is registered and approved, recorded {AMAZON_CA_ACCOUNT_DECLARATION.recordedOn}. This is an owner declaration, not independent confirmation from Amazon.</p>
      <p>Account participation, retailer-link availability and editorial verification are separate. An available affiliate link does not mean we have independently verified the current listing, certified the product or physically tested it. Product-specific restrictions still apply.</p>
    </section>
    <h2>Prices and availability</h2>
    <p>We do not display prices, ratings or stock levels unless they come from an authorised source. Check the merchant page for current details.</p>
    {AMAZON_CA_LINKING_ENABLED
      ? <p>{AMAZON_ASSOCIATE_STATEMENT}</p>
      : <p class="notice">Affiliate programs are not active yet. This page will be updated when they are.</p>}
  </div>
</BaseLayout>
