---
import type { GetStaticPaths } from 'astro';
import ProductProfile from '../../components/ProductProfile.astro';
import { getVisibleProducts, type Product } from '../../lib/products';

export const getStaticPaths = (async () => (await getVisibleProducts()).map((product) => ({ params: { slug: product.id }, props: { product } }))) satisfies GetStaticPaths;
interface Props { product: Product }
const { product } = Astro.props;
---
<ProductProfile product={product} />
