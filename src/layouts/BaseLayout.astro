---
import '../styles/global.css';
import { languageOf, localizedPath, englishPath } from '../i18n/routes';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config/site';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import { GOOGLE_SITE_VERIFICATION } from '../config/analytics';

interface Props {
  title: string;
  canonicalPath?: string;
  description?: string;
  noindex?: boolean;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  canonicalPath: requestedCanonicalPath,
  description = SITE.defaultDescription,
  noindex = false,
  ogImage,
  ogImageWidth, ogImageHeight, ogImageAlt,
  ogType = 'website',
  jsonLd = [],
} = Astro.props;

// Astro's special 404 route is emitted as /404.html on GitHub Pages.
const language = languageOf(Astro.url.pathname);
const canonicalPath = localizedPath(requestedCanonicalPath ?? englishPath(Astro.url.pathname), language);
const englishUrl = new URL(localizedPath(canonicalPath, 'en'), Astro.site).href;
const frenchUrl = new URL(localizedPath(canonicalPath, 'fr'), Astro.site).href;
const canonical = new URL(canonicalPath, Astro.site).href;
const fullTitle = `${title} | ${SITE.name}`;
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).href : undefined;
const safeJson = (data: unknown) => JSON.stringify(data).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={language === 'fr' ? 'fr-CA' : 'en-CA'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />
    <script is:inline define:vars={{ preferredFrenchPath: localizedPath(canonicalPath, 'fr') }}>
      // Explicit French URLs always work, including with storage disabled. A saved
      // French preference follows English entry links without server redirects.
      try {
        if (document.documentElement.lang === 'en-CA' && localStorage.getItem('agl-language') === 'fr') {
          const path = preferredFrenchPath;
          document.documentElement.dataset.languageRedirect = 'true';
          location.replace(path + location.search + location.hash);
        }
      } catch { /* Storage is optional; native language links remain available. */ }
    </script>
    <GoogleAnalytics />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en-CA" href={englishUrl} />
    <link rel="alternate" hreflang="fr-CA" href={frenchUrl} />
    <link rel="alternate" hreflang="x-default" href={englishUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#14130f" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:locale" content={language === 'fr' ? 'fr_CA' : 'en_CA'} />
    <meta property="og:locale:alternate" content={language === 'fr' ? 'en_CA' : 'fr_CA'} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImageUrl && <>
      <meta property="og:image" content={ogImageUrl} />
      <meta property="og:image:type" content="image/webp" />
      {ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
      {ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
      {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
      <meta name="twitter:title" content={fullTitle} />
      <meta name="twitter:description" content={description} />
      <meta name="twitter:image" content={ogImageUrl} />
      {ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}
    </>}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />

    {jsonLd.map((item) => <script type="application/ld+json" set:html={safeJson(language === 'fr' && ['WebSite', 'WebPage', 'CollectionPage', 'Product'].includes(String(item['@type'])) ? { ...item, inLanguage: 'fr-CA' } : item)} />)}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>import '../i18n/client';</script>
  </body>
</html>
