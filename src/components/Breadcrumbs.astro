---
interface Crumb { label: string; href?: string }
interface Props { items: Crumb[] }
const { items } = Astro.props;
const all: Crumb[] = [{ label: 'Home', href: '/' }, ...items];
---

<nav aria-label="Breadcrumb" class="crumbs">
  <ol>
    {all.map((c, i) => (
      <li>
        {c.href && i < all.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .crumbs ol { display: flex; flex-wrap: wrap; gap: var(--s-2); list-style: none; margin: 0 0 var(--s-5); padding: 0; font: var(--fs-mono) var(--f-mono); color: var(--c-muted); }
  .crumbs li + li::before { content: '/'; margin-right: var(--s-2); color: var(--c-line); }
  .crumbs a { color: var(--c-muted); }
</style>
