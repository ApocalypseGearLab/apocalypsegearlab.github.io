  .guide-toc a { display: inline-block; padding-block: 0.4rem; }
  .guide section { max-width: var(--measure); margin-block: var(--s-5); scroll-margin-top: 6rem; }
  .guide h3 { color: var(--accent); line-height: 1.3; }
  .guide-footer { border-top: 1px solid var(--c-line); padding-top: var(--s-4); }
