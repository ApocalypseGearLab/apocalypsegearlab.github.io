---
import { productMedia, mediaUrl, mediaSrcset } from '../lib/media';
import { assetReview, canDisplayProductArtwork } from '../lib/media-policy';
import { importedArtwork, canPublishImportedAsset } from '../lib/imported-media';
import type { UniverseId } from '../config/taxonomy';

interface Props { slug: string; label?: string; detail?: boolean; releasePreview?: boolean; universe?: UniverseId }
const { slug, label = 'Equipment profile', detail = false, releasePreview = false, universe = 'blackout' } = Astro.props;
const supplied = importedArtwork(slug);
const mediaUniverse = supplied?.category ?? universe;
const imageAccent = mediaUniverse === 'fallout' ? '240 123 118' : mediaUniverse === 'outbreak' ? '182 245 102' : '245 166 35';
const asset = supplied ? {
  alt: supplied.alt, identityNote: supplied.reviewNote,
  variants: ('variants' in supplied && supplied.variants) || [{ src: supplied.deliverySrc, width: supplied.width, height: supplied.height }],
} : productMedia(slug);
const review = assetReview(slug);
const editorialArtwork = import.meta.env.DEV && !releasePreview;
const display = supplied ? canPublishImportedAsset(supplied) : canDisplayProductArtwork(slug, editorialArtwork);
const small = asset?.variants[0];
const large = asset?.variants.at(-1);
---

<figure data-artwork-status={display && asset ? supplied?.accuracyStatus ?? review?.accuracyStatus ?? 'pending-review' : 'neutral'} class:list={['product-artwork', { 'product-artwork--detail': detail }]} style={`--media-accent: ${imageAccent}`} >
  {display && asset && small?.src && large?.src ? <>
  <img
    src={mediaUrl(detail ? large.src : small.src)}
    srcset={mediaSrcset(asset)}
    sizes={detail ? '(min-width: 680px) 640px, calc(100vw - 40px)' : '(min-width: 1192px) 220px, (min-width: 1136px) calc((100vw - 312px) / 4), (min-width: 856px) calc((100vw - 238px) / 3), (min-width: 576px) calc((100vw - 164px) / 2), calc(100vw - 90px)'}
    width={large.width} height={large.height}
    alt={asset.alt.replace('AI-assisted illustration', 'Concept illustration')} loading={detail ? 'eager' : 'lazy'} decoding="async"
  />
  <figcaption>
    <span>Concept illustration, not a product photograph.</span>
    {detail && supplied && <span class="identity-note">Illustrated labels are not specifications; see the documented model details.</span>}
    {detail && editorialArtwork && !supplied && <span class="identity-note">{review?.caption ?? review?.note ?? asset.identityNote} Commercial use and source-photo permissions await owner confirmation.</span>}
  </figcaption>
  </> : <>
    <div class="neutral-media" aria-hidden="true"><svg width="64" height="64" viewBox="0 0 64 64" fill="none"><path d="M32 5 55 18v28L32 59 9 46V18Z" stroke="currentColor" stroke-width="1.5"/><path d="M22 25h20v19H22zM27 25v-5h10v5" stroke="currentColor" stroke-width="1.5"/></svg><span class="label">{label}</span></div>
    <figcaption>Product image unavailable.{detail && editorialArtwork && review?.accuracyStatus === 'rejected' && <span class="identity-note">{review.note}</span>}</figcaption>
  </>}
</figure>

<style>
  .product-artwork { margin: 0 0 var(--s-4); min-width: 0; }
  .product-artwork img { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: contain; background: #080807; }
  .product-artwork--detail { width: min(100%, 640px); }
  figcaption { color: var(--c-muted); font-size: 10.5px; line-height: 1.35; padding-top: var(--s-1); }
  .identity-note { display: block; margin-top: 2px; }
  .neutral-media { aspect-ratio: 1; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: var(--s-3); padding: var(--s-5); text-align: center; color: rgb(var(--media-accent)); border: 1px solid var(--c-line); background: linear-gradient(rgb(var(--media-accent) / .045) 1px, transparent 1px) 0 0 / 32px 32px, linear-gradient(90deg, rgb(var(--media-accent) / .045) 1px, transparent 1px) 0 0 / 32px 32px, #10110f; }
</style>
