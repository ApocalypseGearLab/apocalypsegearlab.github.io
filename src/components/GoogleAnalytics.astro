---
// Basic opt-in: the Google tag is created only after valid analytics permission.
---
<script>
  import { installAnalyticsConsent } from '../lib/analytics-consent';
  import { installAffiliateAnalytics } from '../lib/affiliate-analytics';
  if (import.meta.env.PROD) {
    installAnalyticsConsent();
    installAffiliateAnalytics();
  }
</script>
