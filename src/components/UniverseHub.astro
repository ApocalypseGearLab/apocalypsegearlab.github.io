---
import { CINEMATIC } from '../config/cinematic';
import UniverseHero from './UniverseHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import ProductCard from './ProductCard.astro';
import { UNIVERSES } from '../config/site';
import { CATEGORIES, type UniverseId } from '../config/taxonomy';
import { getProductsByUniverse } from '../lib/products';
import { mandatoryHold } from '../lib/release-policy';
import SectorGuide from './SectorGuide.astro';
import { HUB_EDITORIAL_READY, categoryPageCanBeIndexed } from '../lib/category-seo';
import { collectionStructuredData } from '../lib/collection-seo';
import { populatedCategories } from '../lib/category-navigation';

interface Props { id: UniverseId; releasePreview?: boolean }
const { id, releasePreview = false } = Astro.props;
const universe = UNIVERSES[id];
const categories = CATEGORIES.filter((c) => c.universe === id);
const products = (await getProductsByUniverse(id)).filter((product) => !releasePreview || (!mandatoryHold(product) && product.data.reviewStatus !== 'template'));
const indexable = categoryPageCanBeIndexed(HUB_EDITORIAL_READY[id], releasePreview);
const jsonLd = Astro.site ? collectionStructuredData(Astro.site, `/${id}/`, universe.name, products) : [];
const titles = { blackout: 'Power outage preparedness: batteries, lighting & refrigeration', fallout: 'Household emergency supplies: water, food & shelter', outbreak: 'Evacuation gear planning: bags, navigation & protection', whiteout: 'Winter survival gear: insulated sleeping pads & cold-weather shelter' };
---

<BaseLayout canonicalPath={`/${id}/`} title={titles[id]} description={universe.summary} noindex={!indexable} jsonLd={[...jsonLd, {'@context': 'https://schema.org', '@type': 'CollectionPage', name: titles[id], description: universe.summary, url: new URL(`/${id}/`, Astro.site).href, image: new URL(`/images/universes/${id}-survival-og.webp`, Astro.site).href }]} ogImage={`/images/universes/${id}-survival-og.webp`} ogImageWidth={1200} ogImageHeight={630} ogImageAlt={CINEMATIC[id].alt}>
  <UniverseHero id={id} />
  <div class="container hub" data-universe={id} style={`--accent: ${universe.accent}`}>
    <Breadcrumbs items={[{ label: universe.name }]} />

    <header class="section hub-head">
      <p class="label">{universe.signal}</p>
      <p class="lead">{universe.summary}</p>
      <nav class="hub-jumps" aria-label="Sector sections"><a href="#sector-guide">Read the planning guide</a><a href="#gear">Browse sector equipment</a></nav>
      {universe.fiction && products.length > 0 && <p class="label">Equipment profiles are factual references. Any fictional scenarios are labelled separately.</p>}
      {universe.fiction && products.length === 0 && (
        <div class="notice notice--fiction">
          <p class="label">Fiction notice</p>
          <p>Scenarios and simulations in this sector are fictional entertainment. They are never emergency advice. Real preparedness content is labelled separately.</p>
        </div>
      )}
      <div class="notice"><p class="label">Sourcing</p><p>{universe.sourcingNote}</p></div>
    </header>

    {products.length === 0 && <section class="section" aria-labelledby="topics">
      <h2 id="topics">Planned topics</h2>
      <p>These topics are on the editorial roadmap. A topic becomes a link only when its page is complete.</p>
      <ul class="topics">
        {categories.map((c) => <li class="panel"><span>{c.label}</span> <span class="badge">Planned</span></li>)}
      </ul>
    </section>}

    <div id="planning-checklist"><SectorGuide id={id} /></div>

    <section class="section" aria-labelledby="gear">
      <h2 id="gear">Gear in this sector</h2>
      {products.length > 0 && <nav aria-label={`${universe.name} equipment categories`}><ul class="sector-categories">{populatedCategories(products).map(category => <li><a href={category.href}>{category.label}</a></li>)}</ul></nav>}
      {products.some((product) => !product.data.research?.publicationApproved) && <p class="notice">Informational product profiles, not independent product tests. Consult each profile for documented limitations. Retailer listings have not all been independently verified; buying links remain unavailable for unresolved safety or model conflicts.</p>}
      {products.length === 0 ? (
        <p class="empty">No published reviews yet. Recommendations appear here after editorial research and affiliate disclosure.</p>
      ) : (
        <div class="grid grid--3">{products.map((p) => <ProductCard product={p} releasePreview={releasePreview} placement="collection-card" />)}</div>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  /* Deep red remains the sector accent; smaller headings need a lighter text tone. */
  .hub[data-universe='fallout'] :global(.guide h3) { color: #f07b76; }
  .hub-head h1 { color: var(--accent); }
  .sector-categories { display: flex; flex-wrap: wrap; gap: .4rem 1.5rem; padding-left: 1.2rem; margin-bottom: var(--s-5); }
  .sector-categories a { display: inline-flex; align-items: center; min-height: 2.75rem; }
  .lead { font-size: var(--fs-1); }
  .hub-head .notice { margin-top: var(--s-4); }
  .hub-jumps { display: flex; flex-wrap: wrap; gap: var(--s-3) var(--s-5); }
  .hub-jumps a { display: inline-flex; align-items: center; min-height: 2.75rem; }
  .topics { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-3); grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); }
  .topics li { display: flex; justify-content: space-between; align-items: center; gap: var(--s-3); padding: var(--s-4); }
  .hub[data-universe='blackout'] .topics .badge { flex-shrink: 0; white-space: nowrap; }
</style>
