---
import { SITE, NAV, AMAZON_ASSOCIATE_ENROLLED, AMAZON_ASSOCIATE_STATEMENT } from '../config/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <p class="label">{SITE.name}</p>
      <p class="small">Independent preparedness research. Product recommendations are published only after editorial research.</p>
      {AMAZON_ASSOCIATE_ENROLLED && <p class="small">{AMAZON_ASSOCIATE_STATEMENT}</p>}
    </div>
    <nav aria-label="Footer">
      <ul>
        {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href="/affiliate-disclosure/">Affiliate disclosure</a></li>
      </ul>
    </nav>
  </div>
  <div class="container"><p class="label small">&copy; {year} {SITE.name}{import.meta.env.DEV && <> · Version {SITE.version}</>}</p></div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--c-line); padding-block: var(--s-6) var(--s-5); margin-top: var(--s-7); }
  .footer-grid { display: grid; gap: var(--s-6); grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); }
  ul { list-style: none; margin: 0; padding: 0; }
  li { margin-bottom: var(--s-2); }
  .small { font-size: 0.9rem; color: var(--c-muted); }
</style>
