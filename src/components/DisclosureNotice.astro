---
import { AMAZON_CA_LINKING_ENABLED, AMAZON_ASSOCIATE_STATEMENT } from '../config/site';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---

<aside class:list={['affiliate-note', { 'affiliate-note--compact': compact }]} aria-label="Affiliate disclosure">
  <p>{AMAZON_CA_LINKING_ENABLED ? AMAZON_ASSOCIATE_STATEMENT : 'Purchases through affiliate links may earn us a commission.'} <a href="/affiliate-disclosure/">Full disclosure</a>.</p>
</aside>

<style>
  .affiliate-note { color: var(--c-muted); font-size: 0.8rem; line-height: 1.4; }
  .affiliate-note p { margin: 0; }
  .affiliate-note--compact { font-size: 0.75rem; }
</style>
