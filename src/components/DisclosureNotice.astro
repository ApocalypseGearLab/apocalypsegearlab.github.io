---
import { AMAZON_CA_LINKING_ENABLED, AMAZON_ASSOCIATE_STATEMENT } from '../config/site';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---

<aside class:list={['notice', { 'disclosure--compact': compact }]} aria-label="Affiliate disclosure">
  <p class="label">Affiliate disclosure</p>
  <p>
    Some links on this page may be affiliate links. If you buy through them we may earn a commission at no extra cost to you.
    {!compact && 'Commissions never decide what we recommend. '}<a href="/affiliate-disclosure/">Read the full disclosure</a>.
  </p>
  {AMAZON_CA_LINKING_ENABLED && <p>{AMAZON_ASSOCIATE_STATEMENT}</p>}
</aside>

<style>
  .disclosure--compact { font-size: 0.85rem; padding: var(--s-3); }
</style>
