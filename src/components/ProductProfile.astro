---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import AffiliateButton from './AffiliateButton.astro';
import DisclosureNotice from './DisclosureNotice.astro';
import { UNIVERSES } from '../config/site';
import { categoryLabel, categoryUniverse } from '../config/taxonomy';
import { getVisibleProducts, type Product } from '../lib/products';
import { getMerchantLinks } from '../lib/affiliate';
import { productStructuredData } from '../lib/product-seo';
import ProductCard from './ProductCard.astro';
import ProductImage from './ProductImage.astro';
import { isCommerciallyApproved, isInformationalProduct } from '../lib/release-policy';
import { COMPATIBLE_3M_FILTERS, productCaution } from '../lib/respirator-filters';



interface Props { product: Product; releasePreview?: boolean }
const { product, releasePreview = false } = Astro.props;
const { data } = product;
const universe = UNIVERSES[categoryUniverse(data.category)];
const indexable = !releasePreview && isCommerciallyApproved(product);
const informational = isInformationalProduct(product);
const showInternalReview = import.meta.env.DEV && !releasePreview && !informational;
const caution = productCaution(product);
const links = getMerchantLinks(product);
const hasBuyingLinks = links.some((link) => link.href);
const availableLinks = links.filter((link) => link.href || (link.key === 'amazon-ca' && data.links.amazonCa.url));
const verified = data.lastVerified?.toISOString().slice(0, 10);
const research = data.research;
const safetyNotes = research?.safetyNotes.map((note) => note.replace('Do not publish or recommend', 'Do not recommend').replace('before approval', 'before purchase or use').replace('a pre-publication check', 'a check before purchase or use')) ?? [];
const purchaseChecks = data.editorial?.purchaseChecks.length ? data.editorial.purchaseChecks : research?.unverifiedClaims ?? [];
const visibleProducts = await getVisibleProducts();
const related = visibleProducts.filter((candidate) => data.relatedProducts.includes(candidate.id));
const compatibleFilters = product.id === '3m-6800-full-facepiece-respirator'
  ? COMPATIBLE_3M_FILTERS.flatMap((filter) => {
      const candidate = visibleProducts.find(({ id }) => id === filter.id);
      return candidate ? [{ ...filter, product: candidate }] : [];
    }) : [];
const productJson = Astro.site ? productStructuredData(product, Astro.site) : undefined;
const breadcrumbs = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: universe.name, item: new URL(`/${universe.id}/`, Astro.site).href },
    { '@type': 'ListItem', position: 3, name: data.name, item: new URL(`/gear/${product.id}/`, Astro.site).href },
  ],
};
---

<BaseLayout canonicalPath={`/gear/${product.id}/`} title={`${data.name}: specs, uses & limitations`} description={data.summary} noindex={!indexable} ogType="article" jsonLd={[breadcrumbs, ...(productJson ? [productJson] : [])]}>
  <article class="container section stack" data-universe={universe.id} style={`--accent: ${universe.id === 'fallout' ? '#f07b76' : universe.id === 'outbreak' ? '#b6f566' : '#F5A623'}`}>
    <Breadcrumbs items={[{ label: universe.name, href: `/${universe.id}/` }, { label: data.name }]} />

    {!indexable && <p class="notice"><strong>Informational profile{!hasBuyingLinks && ' — verification in progress'}.</strong> {hasBuyingLinks ? (research?.listingVerified ? 'Consult the documented sources and model limitations before buying. ' : 'The retailer link uses the recorded ASIN. The current listing, seller and package have not been independently verified. ') : 'Product identity, Canadian listing and safety documentation have not all been confirmed. '}This is not a hands-on review, certification claim or purchase recommendation. {!hasBuyingLinks && 'Buying links are not active.'}</p>}
    {caution && <aside class="notice product-caution" aria-label="Important product limitation"><strong>{caution}</strong></aside>}

    <p class="label">{categoryLabel(data.category)} · {data.brand}{data.modelNumber ? ` · ${data.modelNumber}` : ''}</p>
    <h1>{data.name}</h1>
    <p>{data.summary}</p>
    <p class="product-status">
      <span class="badge">{data.testing === 'hands-on' ? 'Physically tested by us' : 'Not physically tested by us'}</span>
      {verified && <span class="badge">Last verified {verified}</span>}
      {research && <span class="badge">Sources checked {research.checkedAt}</span>}
    </p>

    {research && showInternalReview && <aside class="notice" aria-label="Research status">
      <p class="label">Research status · {research.safetyStatus === 'blocked' ? 'Publication blocked' : research.safetyStatus === 'pending' ? 'Review pending' : 'Safety review completed'}</p>
      <p>{research.identityNotes}</p>
      {!indexable && <p>This is an editorial preview, not a published recommendation. Source review does not mean the product was physically tested or certified by us.</p>}
    </aside>}

    <ProductImage releasePreview={releasePreview} slug={product.id} label={categoryLabel(data.category)} detail />

    {data.description && <section><h2>Overview</h2><p>{data.description}</p></section>}

    <section>
      <h2>Documented specifications</h2>
      {data.specs.length === 0 ? <p class="empty">No verified specifications yet.</p> : (
        <div class="table-wrap" tabindex="0" role="region" aria-label={`${data.name} specifications`}><table><caption class="visually-hidden">Documented specifications for {data.name}</caption><tbody>
          {data.specs.map((s) => <tr><th scope="row">{s.label}</th><td>{s.value}{s.source && (/^https:\/\//.test(s.source) ? <span class="spec-source"> <a href={s.source}>Source</a></span> : <span class="label"> (source: {s.source})</span>)}</td></tr>)}
        </tbody></table></div>
      )}
    </section>

    <section class="grid grid--2">
      <div><h2>Advantages</h2>{data.pros.length ? <ul>{data.pros.map((x) => <li>{x}</li>)}</ul> : <p class="empty">Not yet assessed.</p>}</div>
      <div><h2>Limitations</h2>{data.cons.length ? <ul>{data.cons.map((x) => <li>{x}</li>)}</ul> : <p class="empty">Not yet assessed.</p>}</div>
    </section>

    {data.useCases.length > 0 && <section><h2>Potential uses and conditions</h2><ul>{data.useCases.map((x) => <li>{x}</li>)}</ul></section>}

    {research && <>
      <section aria-labelledby="evidence"><h2 id="evidence">What the sources confirm</h2>
        <p>These statements cite the linked sources. Manufacturer documentation and retailer representations are identified separately; they are not independent performance measurements.</p>
        <ul>{research.confirmed.map((fact) => <li>{fact.text}{' '}{fact.sourceIds.map((id, index) => <>{index > 0 && ', '}<a href={`#source-${id}`}>Source {data.sources.findIndex((source) => source.id === id) + 1}</a></>)}</li>)}</ul>
      </section>
      {purchaseChecks.length > 0 && <section><h2>What to check before buying</h2><ul>{purchaseChecks.map((claim) => <li>{claim}</li>)}</ul></section>}
      {safetyNotes.length > 0 && <section><h2>Safety and compatibility notes</h2><ul>{safetyNotes.map((note) => <li>{note}</li>)}</ul></section>}
      {showInternalReview && research.publicationBlockers.length > 0 && <section class="notice" aria-labelledby="publication"><h2 id="publication">Before this can be published</h2><ul>{research.publicationBlockers.map((blocker) => <li>{blocker}</li>)}</ul></section>}
    </>}

    {data.sources.length > 0 && <section aria-labelledby="sources"><h2 id="sources">Sources and verification</h2>
      <ol class="sources">{data.sources.map((source) => <li id={`source-${source.id}`}><a href={source.url}>{source.title}</a><span class="label"> · {source.kind.replaceAll('-', ' ')}</span></li>)}</ol>
      <p class="label">A source-check date records the research visit. It does not guarantee the current seller, inventory, recall status or certification of a delivered unit.</p>
    </section>}

    <section aria-labelledby="buy" data-product-purchase>
      <h2 id="buy">Where to buy</h2>
      <DisclosureNotice />
      {research?.affiliateReview?.decision === 'hold' && !availableLinks.some(link => link.unavailableReason === research.affiliateReview?.reason) && <p data-commercial-hold-details>{research.affiliateReview.reason}</p>}
      {data.merchant?.notes && showInternalReview && <p>{data.merchant.notes}</p>}
      {availableLinks.length ? <><p class="buttons">{availableLinks.map((link) => <AffiliateButton link={link} productId={product.id} />)}</p>{!availableLinks.some((link) => link.href) && <p>Amazon.ca links are unavailable until the documented product checks are resolved. No price, availability or seller is confirmed.</p>}</> : <p>Retailer links are not available for this profile.</p>}
    </section>

    {compatibleFilters.length > 0 && !releasePreview && <section aria-labelledby="compatible-3m-filters">
      <h2 id="compatible-3m-filters">Compatible 3M Filters &amp; Cartridges</h2>
      <p>The 6800 uses two matching filters or cartridges in an approved configuration. Bayonet compatibility does not establish suitability for a particular hazard. Check the facepiece instructions, component approval labels and assessed contaminant before selection; these components supply no oxygen.</p>
      <ul>{compatibleFilters.map((filter) => <li><a href={`/gear/${filter.id}/`}>3M {filter.model}</a>: {filter.scope}</li>)}</ul>
      <div class="grid grid--3">{compatibleFilters.map((filter) => <ProductCard product={filter.product} />)}</div>
    </section>}

    {related.length > 0 && !releasePreview && <section aria-labelledby="related"><h2 id="related">Related equipment profiles</h2>
      {!indexable && <p>These reference profiles describe documented features and unresolved limitations. They are not purchase recommendations.</p>}
      <div class="grid grid--3">{related.map((candidate) => <ProductCard product={candidate} />)}</div>
    </section>}
  </article>
</BaseLayout>

<style>
  .buttons { display: flex; flex-wrap: wrap; gap: var(--s-3); }
  .product-status { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  ul { max-width: var(--measure); }
  .sources { padding-left: var(--s-5); }
  .sources li { margin-bottom: var(--s-3); scroll-margin-top: 6rem; }
  .spec-source { display: block; font-size: 0.85rem; margin-top: var(--s-2); }
</style>
