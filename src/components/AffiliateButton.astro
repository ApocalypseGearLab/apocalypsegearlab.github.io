---
import { AFFILIATE_REL, isCanadianPurchaseLink, type MerchantLink } from '../lib/affiliate';
import { AMAZON_CA_LINKING_ENABLED } from '../config/site';
import type { CtaPlacement } from '../lib/affiliate-analytics';

interface Props { link: MerchantLink; productId: string; productName: string; placement: CtaPlacement }
const { link, productId, productName, placement } = Astro.props;
const active = AMAZON_CA_LINKING_ENABLED && isCanadianPurchaseLink(link);
---

{link.key === 'amazon-ca' && (active ? (
  <a
    class="btn btn--primary"
    href={link.href}
    target="_blank"
    rel={AFFILIATE_REL}
    data-affiliate-click
    data-product={productId}
    data-product-name={productName}
    data-cta-placement={placement}
    data-merchant={link.key}
    data-marketplace={link.marketplace}
  >View on Amazon.ca <span class="visually-hidden">(affiliate link, opens in a new tab)</span></a>
) : (
  <span class="btn btn--pending" role="link" aria-disabled="true">{link.label}<span class="label">{link.unavailableReason ?? (link.marketplace !== 'other' && !AMAZON_CA_LINKING_ENABLED ? 'Affiliate eligibility unconfirmed' : 'Listing verification pending')}</span></span>
))}

<style>
  .btn--pending { flex-direction: column; align-items: flex-start; max-width: 100%; }
  .btn--primary { background: var(--accent, var(--c-amber)); border-color: var(--accent, var(--c-amber)); }
  .btn--primary:hover { background: var(--accent, var(--c-amber)); border-color: var(--accent, var(--c-amber)); filter: brightness(1.1); }
</style>
