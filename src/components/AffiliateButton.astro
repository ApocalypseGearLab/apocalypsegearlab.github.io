---
import { AFFILIATE_REL, type MerchantLink } from '../lib/affiliate';
import { AMAZON_CA_LINKING_ENABLED } from '../config/site';

interface Props { link: MerchantLink; productId: string }
const { link, productId } = Astro.props;
---

{link.href ? (
  <a
    class="btn btn--primary"
    href={link.href}
    target="_blank"
    rel={AFFILIATE_REL}
    data-affiliate-click
    data-product={productId}
    data-merchant={link.key}
    data-marketplace={link.marketplace}
  >{link.label} <span class="visually-hidden">(affiliate link, opens in a new tab)</span></a>
) : (
  <span class="btn btn--pending" role="link" aria-disabled="true">{link.label}<span class="label">{link.unavailableReason ?? (link.marketplace !== 'other' && !AMAZON_CA_LINKING_ENABLED ? 'Affiliate eligibility unconfirmed' : 'Listing verification pending')}</span></span>
)}

<style>
  .btn--pending { flex-direction: column; align-items: flex-start; max-width: 100%; }
</style>
