---
import type { Product } from '../lib/products';
import { UNIVERSES } from '../config/site';
import { categoryLabel, categoryUniverse } from '../config/taxonomy';
import ProductImage from './ProductImage.astro';
import { importedArtwork, canPublishImportedAsset } from '../lib/imported-media';
import { productVerification } from '../lib/product-verification';
import { productCaution } from '../lib/respirator-filters';
import { getMerchantLinks } from '../lib/affiliate';
import AffiliateButton from './AffiliateButton.astro';
import DisclosureNotice from './DisclosureNotice.astro';
import type { CtaPlacement } from '../lib/affiliate-analytics';

interface Props { product: Product; headingLevel?: 2 | 3; releasePreview?: boolean; placement?: CtaPlacement }
const { product, headingLevel = 3, releasePreview = false, placement = 'related-card' } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
const { data } = product;
const review = productVerification(product);
const amazonLink = getMerchantLinks(product).find(link => link.key === 'amazon-ca');
const universe = UNIVERSES[categoryUniverse(data.category)];
const artwork = importedArtwork(product.id);
const illustrated = artwork && canPublishImportedAsset(artwork);
const profileHref = `${releasePreview ? '/review' : ''}/gear/${product.id}/`;
---

<article class:list={['panel', 'card', { 'card--illustrated': illustrated }]} data-product-id={product.id} data-universe={universe.id} style={`--accent: ${universe.id === 'whiteout' ? '#7DD3FC' : universe.id === 'fallout' ? '#f07b76' : universe.id === 'outbreak' ? '#b6f566' : '#F5A623'}`}>
  <ProductImage slug={product.id} label={categoryLabel(data.category)} universe={universe.id} releasePreview={releasePreview} />
  <p class="label">{universe.name} · {categoryLabel(data.category)}</p>
  <p class="brand">{data.brand}{data.modelNumber ? ` · ${data.modelNumber}` : ''}</p>
  <Heading><a href={profileHref}>{data.name}</a></Heading>
  <p>{data.summary}</p>
  <div class="card-review" data-product-review>
    <p data-editorial-status={review.editorialApproved ? 'model-reviewed' : 'incomplete'}><span class:list={['badge', { 'badge--warn': !review.fullyApproved }]}>{review.profileLabel} · {review.editorialApproved ? review.editorialLabel : review.evidenceLabel}</span></p>
    <p data-listing-status={review.listingStatus}>{review.listingLabel}</p>
  </div>
  {productCaution(product) && <p class="card-caution">{productCaution(product)!.split('. ')[0]}.</p>}
  {!productCaution(product) && data.cons[0] && <p class="card-caution"><strong>Consider:</strong> {data.cons[0]}</p>}
  {(!data.links.amazonCa.url || amazonLink?.href) && <a class="profile-details" href={profileHref}>Product details<span class="visually-hidden"> for {data.name}</span></a>}
  {data.links.amazonCa.url && amazonLink && <div class="card-purchase">
    {amazonLink.href && <><p class="label" data-link-status="active">{review.linkLabel}</p><DisclosureNotice compact /></>}
    {amazonLink.href ? <AffiliateButton link={amazonLink} productId={product.id} productName={data.name} placement={placement} /> : <>
      <p class="label pending-message" data-amazon-pending data-link-status="held">Amazon link pending verification</p>
      <p class="card-hold-reason">{review.linkBlocker?.split('. ')[0]?.replace(/\.$/, '')}.</p>
      <a class="profile-details" href={profileHref} data-pending-details>Details<span class="visually-hidden"> about {data.name}</span></a>
    </>}
  </div>}
</article>

<style>
  .card :is(h2, h3) { margin-bottom: var(--s-2); font-size: var(--fs-1); }
  .card :is(h2, h3) a { color: var(--c-text); text-decoration: none; }
  .card :is(h2, h3) a:hover { color: var(--accent); }
  .card--illustrated::before, .card--illustrated::after { display: none; }
  .card--illustrated:focus-within { border-color: var(--accent); }
  @media (hover: hover) { .card--illustrated:hover { border-color: var(--accent); } }
  .brand { color: var(--c-muted); font-size: 0.9rem; }
  .card-review { display: grid; gap: var(--s-2); color: var(--c-muted); font-size: 0.85rem; }
  .card-review p { margin: 0; }
  .card-purchase { display: grid; gap: var(--s-3); margin-top: auto; }
  .pending-message { margin: 0; }
  .card-caution { font-size: 0.9rem; border-left: 2px solid var(--accent); padding-left: var(--s-3); }
  .card-hold-reason { font-size: 0.85rem; margin: 0; }
  .profile-details { display: inline-flex; align-items: center; min-height: 2.75rem; padding-block: 0.5rem; }
</style>
