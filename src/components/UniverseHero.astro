---
import { CINEMATIC, cinematicSrc, cinematicSrcset } from '../config/cinematic';
import { UNIVERSES } from '../config/site';
import type { UniverseId } from '../config/taxonomy';
interface Props { id: UniverseId }
const { id } = Astro.props;
const scene = CINEMATIC[id];
const universe = UNIVERSES[id];
---
<header class="universe-hero" data-universe={id} style={`--accent: ${universe.accent}; --scene-position: ${scene.position}`}>
  <div class="scene"><img src={cinematicSrc(id, 1280)} srcset={cinematicSrcset(id)} sizes="100vw" width="1600" height="900" alt={scene.alt} fetchpriority="high" loading="eager" decoding="async" /></div>
  <div class="container scene-copy"><div class="scene-panel"><p class="label">{universe.signal} / Preparedness division</p><h1>{universe.name}</h1><p class="scene-title">{scene.title}</p><p>{universe.tagline}</p><nav aria-label="Sector quick links"><a class="btn" href="#sector-guide">Planning guide</a><a class="btn" href="#gear">Sector equipment</a></nav></div></div>
</header>
<style>
  .universe-hero { background: #05090c; border-bottom: 1px solid var(--accent); }
  .scene { height: clamp(19rem, 42vw, 43rem); overflow: hidden; }
  .scene img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: var(--scene-position); }
  .scene-copy { position: relative; margin-top: -7rem; padding-bottom: 1.5rem; }
  .scene-panel { max-width: 38rem; background: #090e12; border-left: 3px solid var(--accent); padding: clamp(1.25rem, 3vw, 2rem); box-shadow: 0 12px 35px #0006; }
  h1 { color: var(--accent); text-transform: uppercase; margin-bottom: .3rem; }
  .scene-title { font-family: var(--f-mono); text-transform: uppercase; letter-spacing: .13em; font-size: clamp(.9rem, 2vw, 1.25rem); color: #f0f9ff; }
  nav { display: flex; gap: .75rem; flex-wrap: wrap; }
  .btn {
    display: inline-flex;
    align-items: center;
    padding: .6rem 1.2rem;
    border: 1px solid var(--accent);
    color: var(--accent);
    text-decoration: none;
    transition: background 200ms ease, color 200ms ease, box-shadow 200ms ease, border-color 200ms ease;
    font-weight: 600;
  }
  .btn:hover, .btn:focus-visible {
    background: var(--accent);
    color: #05090c;
    border-color: var(--accent);
    box-shadow: 0 0 15px var(--accent);
    outline: none;
  }
  .btn:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .universe-hero[data-universe='fallout'] .btn { color: #f07b76; }
  @media (max-width: 639px) { .scene { height: 22rem; } .scene-copy { margin-top: 0; padding-top: 1rem; } }
</style>
